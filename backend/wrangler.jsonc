{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-profile-typeracer",
  "main": "index.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://ablonewolf.github.io"
  },
  "ratelimits": [
    {
      "name": "PROFILE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
